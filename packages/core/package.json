{
  "name": "@jperezmart/package-template-core",
  "version": "0.0.0",
  "private": true,
  "description": "Worked example of a publishable package. Rename it, drop `private`, and fix `repository`.",
  "keywords": [],
  "homepage": "https://github.com/jperezmart/package-template/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/jperezmart/package-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jperezmart/package-template.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Javier Pérez Martín <javier.perez.martin97@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
